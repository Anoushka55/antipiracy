# Session signing secret — generate a unique value in any non-demo environment.
SESSION_SECRET=schand-command-center-prototype-dev-secret-change-me

# Demo tenant
DEFAULT_TENANT_ID=SCHAND

# Environment label shown in the top bar
APP_ENV=prototype

# Optional: persist in-memory store to disk between restarts
PERSIST_STORE=true

# Future production integrations (unused in prototype)
# TELEGRAM_API_CREDENTIALS=
# MARKETPLACE_API_KEY=
# OBJECT_STORAGE_BUCKET=
# SSO_ISSUER=
# SIEM_ENDPOINT=
